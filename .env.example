# Garmin Connect (Web) → Personal API Key. Wird automatisch gegen ein 24-h-Token getauscht.
GARMIN_API_KEY=
# Ablaufdatum des Keys (beim Anlegen gewählt, YYYY-MM-DD) – die App warnt 30 Tage vorher
GARMIN_API_KEY_EXPIRES=
# Optional: Hersteller importierter Aktivitäten mit gekoppeltem Brustgurt (kommagetrennt, z. B. ZWIFT)
GARMIN_STRAP_IMPORTS=

# WHOOP Developer Dashboard → eigene App
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Muss exakt einer im WHOOP-Dashboard eingetragenen Redirect-URL entsprechen
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback

# Optional: Zeitzone für Anzeige und „heute“ (IANA-Name)
TIMEZONE=Europe/Berlin
